# Copy this file to .env for repo-local Qwen server and jcode settings.
#
# none: fastest routine work, with reasoning disabled
# low: balanced daily-driver profile
# medium/xhigh: progressively more reasoning for difficult work
QWEN_REASONING_EFFORT=low

# Maximum reasoning tokens per request. Use -1 for no explicit limit.
QWEN_REASONING_BUDGET_TOKENS=2048

# Measured DGX Spark coding profile. Keep one variable per A/B trial.
QWEN_MTP_DRAFT_N_MAX=3
QWEN_BATCH_SIZE=2048
QWEN_UBATCH_SIZE=512
QWEN_BACKEND_SAMPLING=0
QWEN_LOAD_MODE=auto
QWEN_CUDA_GRAPH_OPT=0
QWEN_CUDA_CUB_3DOT2=OFF

# Advanced escape hatch. When set, this complete JSON body wins over the two
# friendly variables above.
# JCODE_OPENAI_EXTRA_BODY={"reasoning_effort":"none"}
